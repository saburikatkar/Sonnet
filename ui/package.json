{
  "name": "team-synora-ui",
  "productName": "Team Synora",
  "version": "0.1.0",
  "private": true,
  "description": "Team Synora desktop shell (Electron + React + Vite)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "dev:vite": "vite",
    "dev:electron": "electron . --dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "test": "node --test test/contract.test.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
